# Copy to .env and adjust
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/codealpha_social
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of extra origins allowed to call the API (the app itself is always allowed)
CORS_ORIGINS=
